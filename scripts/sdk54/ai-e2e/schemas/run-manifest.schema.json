{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "expo-harmony-sdk54-ai-e2e-run-manifest-v1",
  "type": "object",
  "required": ["schemaVersion", "runId", "stage", "source", "caseSet", "candidate", "repositoryRoot", "consumerRoot", "tools"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
    "stage": { "type": "string", "minLength": 1 },
    "source": { "type": "object", "required": ["revision", "dirty"] },
    "caseSet": { "$ref": "#/$defs/reference" },
    "candidate": { "$ref": "#/$defs/reference" },
    "repositoryRoot": { "type": "string", "minLength": 1 },
    "consumerRoot": { "type": "string", "minLength": 1 },
    "tools": { "type": "object", "required": ["node", "npm", "pnpm"] },
    "device": { "type": "object", "required": ["target", "platformVersion"] },
    "caseCommands": { "type": "object" }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
