{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "expo-harmony-sdk54-ai-e2e-run-manifest-v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "stage",
    "source",
    "caseSet",
    "candidate",
    "repositoryRoot",
    "consumerRoot",
    "tools"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "revision",
        "dirty"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "caseSet": {
      "$ref": "#/$defs/reference"
    },
    "candidate": {
      "$ref": "#/$defs/reference"
    },
    "repositoryRoot": {
      "type": "string",
      "pattern": "^/[^\\u0000]*$"
    },
    "consumerRoot": {
      "type": "string",
      "pattern": "^/[^\\u0000]*$"
    },
    "tools": {
      "type": "object",
      "required": [
        "node",
        "npm",
        "pnpm"
      ],
      "properties": {
        "node": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$"
        },
        "npm": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$"
        },
        "pnpm": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$"
        }
      }
    },
    "device": {
      "type": "object",
      "required": [
        "target",
        "platformVersion"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "platformVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "caseCommands": {
      "type": "object"
    },
    "m4": {
      "type": "object",
      "properties": {
        "other": {
          "type": "object",
          "properties": {
            "caseCaptures": {
              "type": "object",
              "required": [
                "M4-A03-splash",
                "M4-A03-system-ui",
                "M4-A03-status-bar",
                "M4-A04-linking-router",
                "M4-A05-browser",
                "M4-A07-package-sync"
              ],
              "additionalProperties": false,
              "properties": {
                "M4-A03-splash": {
                  "$ref": "#/$defs/otherCapture"
                },
                "M4-A03-system-ui": {
                  "$ref": "#/$defs/otherCapture"
                },
                "M4-A03-status-bar": {
                  "$ref": "#/$defs/otherCapture"
                },
                "M4-A04-linking-router": {
                  "$ref": "#/$defs/otherCapture"
                },
                "M4-A05-browser": {
                  "$ref": "#/$defs/otherCapture"
                },
                "M4-A07-package-sync": {
                  "$ref": "#/$defs/otherCapture"
                }
              }
            },
            "captures": false
          }
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\.\\.?(?:/|$))[^/\\\\\\u0000]+(?:/(?!\\.\\.?(?:/|$))[^/\\\\\\u0000]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "otherCapture": {
      "type": "object",
      "required": [
        "bundle",
        "pid",
        "hap",
        "mode",
        "bootIds",
        "captureCwd",
        "capture"
      ],
      "properties": {
        "bundle": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "hap": {
          "$ref": "#/$defs/reference"
        },
        "capture": {
          "$ref": "#/$defs/reference"
        },
        "mode": {
          "enum": [
            "debug",
            "release"
          ]
        },
        "bootIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000]+$"
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            ]
          }
        },
        "captureCwd": {
          "type": "string",
          "pattern": "^/[^\\u0000]*$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "m4"
        ],
        "properties": {
          "m4": {
            "required": [
              "other"
            ],
            "properties": {
              "other": {
                "required": [
                  "caseCaptures"
                ]
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "device"
        ]
      }
    }
  ]
}
