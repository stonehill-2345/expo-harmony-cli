+import { Image as RNImage } from 'react-native';
+
+import type { ImageNativeModule } from './Image.types';
+
+const ImageModule = {
+  Image: null,
+  async prefetch(urls: string[]) {
+    const results = await Promise.all(urls.map((url) => RNImage.prefetch(url)));
+    return results.every(Boolean);
+  },
+  async clearMemoryCache() {
+    return true;
+  },
+  async clearDiskCache() {
+    return true;
+  },
+  async getCachePathAsync() {
+    return null;
+  },
+  async generateBlurhashAsync() {
+    return null;
+  },
+  async generateThumbhashAsync() {
+    return null;
+  },
+  async loadAsync() {
+    throw new Error('Image.loadAsync is not supported on HarmonyOS');
+  },
+} as unknown as ImageNativeModule;
+
+export default ImageModule;
