+import React from 'react';
+import { Image as RNImage, StyleSheet } from 'react-native';
+
+import type { ImageNativeProps } from './Image.types';
+
+const resizeModes = {
+  cover: 'cover',
+  contain: 'contain',
+  fill: 'stretch',
+  none: 'center',
+  'scale-down': 'center',
+} as const;
+
+class ExpoImage extends React.PureComponent<ImageNativeProps> {
+  startAnimating = () => undefined;
+  stopAnimating = () => undefined;
+  lockResourceAsync = async () => undefined;
+  unlockResourceAsync = async () => undefined;
+  reloadAsync = async () => undefined;
+
+  componentDidMount() {
+    this.setNativeViewRef(this);
+  }
+
+  componentWillUnmount() {
+    this.setNativeViewRef(null);
+  }
+
+  private setNativeViewRef(value: ExpoImage | null) {
+    const ref = this.props.nativeViewRef as React.MutableRefObject<ExpoImage | null> | undefined;
+    if (ref) ref.current = value;
+  }
+
+  render() {
+    const {
+      accessibilityLabel,
+      alt,
+      contentFit = 'cover',
+      nativeViewRef: _nativeViewRef,
+      containerViewRef,
+      onDisplay,
+      onLoad,
+      onError,
+      placeholder,
+      source,
+      style,
+      transition: _transition,
+      ...props
+    } = this.props;
+    const resolvedSource = Array.isArray(source) ? source[0] : source;
+    const defaultSource = Array.isArray(placeholder) ? placeholder[0] : placeholder;
+
+    return (
+      <RNImage
+        {...(props as any)}
+        ref={containerViewRef as any}
+        accessibilityLabel={accessibilityLabel ?? alt}
+        defaultSource={defaultSource as any}
+        resizeMode={resizeModes[contentFit] ?? 'cover'}
+        source={resolvedSource as any}
+        style={StyleSheet.flatten(style)}
+        onLoad={(event) => {
+          const { width, height, uri = '' } = event.nativeEvent.source;
+          onLoad?.({ cacheType: 'none', source: { url: uri, width, height, mediaType: null } });
+          onDisplay?.();
+        }}
+        onError={(event) => onError?.({ error: event.nativeEvent.error })}
+      />
+    );
+  }
+}
+
+export default ExpoImage;
