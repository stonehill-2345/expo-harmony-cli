+import { RNOHPackage } from '@rnoh/react-native-openharmony';
+import type { RNPackageContext, UITurboModule, UITurboModuleContext } from '@rnoh/react-native-openharmony';
+import { ExpoLinkingLifecycle } from './ExpoLinkingLifecycle';
+import { ExpoLinkingTurboModule } from './ExpoLinkingTurboModule';
+
+export class ExpoLinkingPackage extends RNOHPackage {
+  private readonly lifecycle: ExpoLinkingLifecycle;
+
+  public constructor(ctx: RNPackageContext, lifecycle: ExpoLinkingLifecycle) {
+    super(ctx);
+    this.lifecycle = lifecycle;
+  }
+
+  public override getUITurboModuleFactoryByNameMap(): Map<string, (ctx: UITurboModuleContext) => UITurboModule | null> {
+    return new Map<string, (ctx: UITurboModuleContext) => UITurboModule>().set(
+      ExpoLinkingTurboModule.NAME,
+      (ctx: UITurboModuleContext) => new ExpoLinkingTurboModule(ctx, this.lifecycle)
+    );
+  }
+
+  public override getDebugName(): string { return 'expo-linking'; }
+}
diff --git a/node_modules/expo-linking/harmony/src/main/ets/ExpoLinkingTurboModule.ets b/node_modules/expo-linking/harmony/src/main/ets/ExpoLinkingTurboModule.ets
new file mode 100644
index 0000000..70f1f33
--- /dev/null
+++ b/node_modules/expo-linking/harmony/src/main/ets/ExpoLinkingTurboModule.ets
@@ -0,0 +1,33 @@
+import { UITurboModule } from '@rnoh/react-native-openharmony';
+import type { UITurboModuleContext } from '@rnoh/react-native-openharmony';
+import { ExpoLinkingLifecycle } from './ExpoLinkingLifecycle';
+
+interface URLEvent { url: string; }
+
+export class ExpoLinkingTurboModule extends UITurboModule {
+  public static readonly NAME = 'ExpoLinking';
+  private readonly unsubscribe: () => void;
+  private destroyed = false;
+
+  private readonly lifecycle: ExpoLinkingLifecycle;
+
+  public constructor(ctx: UITurboModuleContext, lifecycle: ExpoLinkingLifecycle) {
+    super(ctx);
+    this.lifecycle = lifecycle;
+    this.unsubscribe = lifecycle.subscribe((url: string) => {
+      const event: URLEvent = { url };
+      this.ctx.rnInstance.postMessageToCpp('ExpoLinking:onURLReceived', event);
+    });
+  }
+
+  public getLinkingURL(): string | null {
+    if (this.destroyed) throw new Error('ExpoLinking module was destroyed');
+    return this.lifecycle.getLinkingURL();
+  }
+
+  public override __onDestroy__(): void {
+    this.destroyed = true;
+    this.unsubscribe();
+    super.__onDestroy__();
+  }
+}
