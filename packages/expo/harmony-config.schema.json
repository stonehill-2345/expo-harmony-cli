{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Expo Harmony configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "bundleName": {
      "type": "string",
      "minLength": 7,
      "maxLength": 128,
      "pattern": "^(?:[a-zA-Z](?:\\w*[0-9a-zA-Z])?)(?:\\.[0-9a-zA-Z](?:\\w*[0-9a-zA-Z])?){2,}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 127,
      "pattern": "^(?:[0-9.]+|(?=.*[{])(?=.*[}])[0-9a-zA-Z_.{}]+)$"
    },
    "versionCode": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "icon": { "type": "string", "minLength": 1 },
    "foregroundImage": { "type": "string", "minLength": 1 },
    "splash": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "backgroundColor": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        }
      }
    },
    "scheme": {
      "anyOf": [
        { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*$" },
        {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*$" }
        }
      ]
    },
    "querySchemes": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 200,
      "items": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*$" }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:[$]string:[0-9a-zA-Z_.]+|(?=.*[{])(?=.*[}])[0-9a-zA-Z_.{}]+)$"
          },
          "usedScene": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "abilities": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "when": { "enum": ["inuse", "always"] }
            }
          }
        }
      }
    },
    "orientation": { "enum": ["default", "portrait", "landscape"] },
    "userInterfaceStyle": { "enum": ["light", "dark", "automatic"] },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app": { "type": "object", "additionalProperties": true },
        "module": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
